<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MauiPagingSample.ViewModels"
    x:Class="MauiPagingSample.Views.ItemTemplates.CarItemView"
    x:DataType="vm:CarItemViewModel">
    <Grid RowDefinitions="*,1">
        <Label
            Grid.Row="0"
            Padding="16,8"
            FontAttributes="Bold"
            Text="{Binding Name}" />
        <BoxView
            Grid.Row="1"
            HeightRequest="1"
            Color="{StaticResource Gray500}" />
    </Grid>
</ContentView>
